# Login for the tracker. Set these in Vercel (Project Settings -> Environment Variables)
# and in .env.local for local development. Never commit real values.

# The only email allowed to sign in
AUTH_EMAIL=you@example.com

# scrypt hash of the password. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
AUTH_PASSWORD_HASH=

# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
